{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/.well-known/agent-instructions.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/inquiry", "destination": "/inquiry.html" },
    { "source": "/start", "destination": "/inquiry.html" },
    { "source": "/transformation", "destination": "/inquiry.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy.md", "destination": "/privacy.md" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/404", "destination": "/404.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/services/web-applications-cloud-architecture", "destination": "/services/web-applications-cloud-architecture.html" },
    { "source": "/services/3d-websites-webgl-experiences", "destination": "/services/3d-websites-webgl-experiences.html" },
    { "source": "/services/fintech-solutions-payment-infrastructure", "destination": "/services/fintech-solutions-payment-infrastructure.html" },
    { "source": "/services/healthtech-platforms-clinical-portals", "destination": "/services/healthtech-platforms-clinical-portals.html" },
    { "source": "/services/seo", "destination": "/services/seo.html" },
    { "source": "/services/aeo", "destination": "/services/aeo.html" },
    { "source": "/services/ai-automation", "destination": "/services/ai-automation.html" },
    { "source": "/automations", "destination": "/automations.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/team", "destination": "/team.html" },
    { "source": "/success-stories", "destination": "/success-stories.html" },
    { "source": "/innovation-lab", "destination": "/innovation-lab.html" },
    { "source": "/services/for-your-industry", "destination": "/services/for-your-industry.html" },
    { "source": "/services/website-design-for-hvac-companies", "destination": "/services/website-design-for-hvac-companies.html" },
    { "source": "/services/website-design-for-landscapers", "destination": "/services/website-design-for-landscapers.html" },
    { "source": "/services/website-design-for-plumbing-companies", "destination": "/services/website-design-for-plumbing-companies.html" },
    { "source": "/services/website-design-for-auto-body-shops", "destination": "/services/website-design-for-auto-body-shops.html" },
    { "source": "/services/website-design-for-cleaning-companies", "destination": "/services/website-design-for-cleaning-companies.html" },
    { "source": "/services/website-design-for-remodeling-contractors", "destination": "/services/website-design-for-remodeling-contractors.html" },
    { "source": "/services/website-design-for-roofing-companies", "destination": "/services/website-design-for-roofing-companies.html" },
    { "source": "/services/website-design-for-salons-and-spas", "destination": "/services/website-design-for-salons-and-spas.html" },
    { "source": "/services/website-design-for-home-service-companies", "destination": "/services/website-design-for-home-service-companies.html" },
    { "source": "/services/website-design-for-dentists", "destination": "/services/website-design-for-dentists.html" }
  ],
  "redirects": [
    { "source": "/a8-automations", "destination": "/automations", "statusCode": 301 },
    { "source": "/services/web-apps", "destination": "/services/web-applications-cloud-architecture", "statusCode": 301 },
    { "source": "/services/3d-webgl", "destination": "/services/3d-websites-webgl-experiences", "statusCode": 301 },
    { "source": "/services/fintech-solutions", "destination": "/services/fintech-solutions-payment-infrastructure", "statusCode": 301 },
    { "source": "/services/healthtech-platforms", "destination": "/services/healthtech-platforms-clinical-portals", "statusCode": 301 }
  ]
}