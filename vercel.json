{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/.well-known/agent-instructions.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/inquiry", "destination": "/inquiry.html" },
    { "source": "/start", "destination": "/inquiry.html" },
    { "source": "/transformation", "destination": "/inquiry.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy.md", "destination": "/privacy.md" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/404", "destination": "/404.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/services/web-applications-cloud-architecture", "destination": "/services/web-applications-cloud-architecture.html" },
    { "source": "/services/web-apps", "destination": "/services/web-apps.html" },
    { "source": "/services/3d-websites-webgl-experiences", "destination": "/services/3d-websites-webgl-experiences.html" },
    { "source": "/services/3d-webgl", "destination": "/services/3d-webgl.html" },
    { "source": "/services/fintech-solutions-payment-infrastructure", "destination": "/services/fintech-solutions-payment-infrastructure.html" },
    { "source": "/services/fintech-solutions", "destination": "/services/fintech-solutions.html" },
    { "source": "/services/healthtech-platforms-clinical-portals", "destination": "/services/healthtech-platforms-clinical-portals.html" },
    { "source": "/services/healthtech-platforms", "destination": "/services/healthtech-platforms.html" },
    { "source": "/services/seo", "destination": "/services/seo.html" },
    { "source": "/services/aeo", "destination": "/services/aeo.html" },
    { "source": "/services/ai-automation", "destination": "/services/ai-automation.html" },
    { "source": "/automations", "destination": "/automations.html" },
    { "source": "/a8-automations", "destination": "/a8-automations.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/team", "destination": "/team.html" },
    { "source": "/success-stories", "destination": "/success-stories.html" },
    { "source": "/innovation-lab", "destination": "/innovation-lab.html" }
  ]
}